.sftp-tab
    .alert.alert-danger.mx-3.mt-3(*ngIf='errorMessage') {{errorMessage}}
    sftp-panel(
        *ngIf='sshSession',
        [session]='sshSession',
        [(path)]='path',
        [initialLocalPath]='initialLocalPath',
        [cwdDetectionAvailable]='cwdDetectionAvailable',
        (closed)='close()'
    )
