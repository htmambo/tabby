.body(dropZone, (transfer)='uploadOneFolder($event)')
    a.alert.alert-info.d-flex.align-items-center(
        *ngIf='shouldShowCWDTip && !cwdDetectionAvailable',
        (click)='platform.openExternal("https://tabby.sh/go/cwd-detection")'
    )
        .me-auto
            strong(translate) Working directory detection
            div(translate) Learn how to allow Tabby to detect remote shell's working directory.
        button.close((click)='dismissCWDTip()')
            i.fas.fa-close

    .alert.alert-danger(*ngIf='initError') {{initError}}
    div(*ngIf='!sftp && !initError', translate) Connecting
    .panes(*ngIf='sftp')
        .pane.local-pane(*ngIf='showLocalPanel')
            .pane-header
                .pane-title(translate) Local files
                .pane-actions
                    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='selectLocalDirectory()')
                        i.fas.fa-folder-open.me-1
                        div(translate) Select directory
            .pane-path
                .path-display
                    .breadcrumb
                        a.breadcrumb-item.text-decoration-none(
                            *ngFor='let segment of localPathSegments',
                            (click)='navigateLocal(segment.path)'
                        ) {{segment.name}}
                    .breadcrumb-spacer.flex-grow-1.h-100
            .pane-body((contextmenu)='showPaneContextMenu(false, $event)')
                div(*ngIf='localFileList === null', translate) Loading
                .list-group.list-group-light(*ngIf='localFileList !== null')
                    .list-group-item.list-group-item-action.d-flex.align-items-center(
                        *ngIf='canLocalGoUp && (!showFilter || filterText.trim() === "")',
                        (click)='localGoUp()'
                    )
                        i.fas.fa-fw.fa-level-up-alt
                        div(translate) Go up
                    .list-group-item.list-group-item-action.d-flex.align-items-center(
                        *ngFor='let item of filteredLocalFileList',
                        (contextmenu)='showLocalContextMenu(item, $event)',
                        (click)='onLocalItemClick(item)',
                        (dblclick)='onLocalItemDoubleClick(item)',
                        [class.local-selected]='selectedLocalItemPath === item.fullPath'
                    )
                        i.fa-fw([class]='getIcon(item)')
                        div {{item.name}}
                        .me-auto
                        .size(*ngIf='!item.isDirectory') {{item.size|filesize}}
                        .date {{item.modified|tabbyDate}}
                        .mode {{getModeString(item)}}
                .alert.alert-info.text-center.mt-3(*ngIf='localFileList !== null && filteredLocalFileList.length === 0 && showFilter && filterText.trim() !== ""')
                    i.fas.fa-search.me-2
                    span {{getNoFilesMatchMessage()}}

        .pane.remote-pane
            .pane-header
                .pane-title(translate) SFTP
                .pane-actions
                    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(*ngIf='!showFilter', (click)='showFilter = true')
                        i.fas.fa-filter.me-1
                        div(translate) Filter

                    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(*ngIf='selectedRemoteItemsCount > 0', (click)='downloadSelected()')
                        i.fas.fa-download.me-1
                        div(translate) Download selected
                        span.ms-1 {{selectedRemoteItemsCount}}

                    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='openCreateDirectoryModal()')
                        i.fas.fa-plus.me-1
                        div(translate) Create directory

                    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='upload()')
                        i.fas.fa-upload.me-1
                        div(translate) Upload files

                    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='uploadFolder()')
                        i.fas.fa-upload.me-1
                        div(translate) Upload folder

                    button.btn.btn-link.text-decoration-none.flex-shrink-0((click)='close()') !{require('../../../tabby-core/src/icons/times.svg')}
            .pane-path
                input.form-control.flex-grow-1.w-0(
                    *ngIf='editingPath !== null',
                    type='text',
                    autofocus,
                    (keydown.enter)='confirmPath()',
                    (keydown.esc)='editingPath = null',
                    (blur)='editingPath = null',
                    [(ngModel)]='editingPath'
                )
                .path-display(*ngIf='editingPath === null')
                    .breadcrumb((dblclick)='editPath()')
                        a.breadcrumb-item.text-decoration-none((click)='navigate("/")') /
                        a.breadcrumb-item.text-decoration-none(
                            *ngFor='let segment of pathSegments',
                            (click)='navigate(segment.path)'
                        ) {{segment.name}}

                    .breadcrumb-spacer.flex-grow-1.h-100((dblclick)='editPath()')
            .pane-filter.px-3.py-2.border-bottom(*ngIf='showFilter')
                .input-group
                    input.form-control(
                        type='text',
                        placeholder='{{ "Filter" | translate }}',
                        autofocus,
                        [(ngModel)]='filterText',
                        (input)='onFilterChange()',
                        (keydown.escape)='clearFilter()'
                    )
                    button.btn.btn-secondary((click)='clearFilter()')
                        i.fas.fa-times
            .pane-body((contextmenu)='showPaneContextMenu(true, $event)')
                div(*ngIf='fileList === null', translate) Loading
                .list-group.list-group-light(*ngIf='fileList !== null')
                    .list-group-item.list-group-item-action.d-flex.align-items-center(
                        *ngIf='path !== "/" && (!showFilter || filterText.trim() === "")',
                        (click)='goUp()'
                    )
                        i.fas.fa-fw.fa-level-up-alt
                        div(translate) Go up
                    .list-group-item.list-group-item-action.d-flex.align-items-center(
                        *ngFor='let item of filteredFileList',
                        (contextmenu)='showContextMenu(item, $event)',
                        (click)='onRemoteItemClick(item, $event)',
                        (dblclick)='onRemoteItemDoubleClick(item)',
                        [class.remote-selected]='isRemoteItemSelected(item)'
                    )
                        i.fa-fw([class]='getIcon(item)')
                        div {{item.name}}
                        .me-auto
                        .size(*ngIf='!item.isDirectory') {{item.size|filesize}}
                        .date {{item.modified|tabbyDate}}
                        .mode {{getModeString(item)}}
                .alert.alert-info.text-center.mt-3(*ngIf='fileList !== null && filteredFileList.length === 0 && showFilter && filterText.trim() !== ""')
                    i.fas.fa-search.me-2
                    span {{getNoFilesMatchMessage()}}
