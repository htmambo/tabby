{
    "extends": "../tsconfig.json",
    "files": ["src/index.ts", "src/index-minimal.ts", "types/legacy-modules.d.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "integration-tests",
        "setup-jest.ts",
        "**/*.spec.ts",
        "**/*.test.ts"
    ],
    "compilerOptions": {
        "baseUrl": "src",
        "noImplicitAny": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "paths": {
            "*": [
                "../../node_modules/*",
                "../../app/node_modules/*",
                "./*"
            ],
            "tabby-*": [
                "../../tabby-*/src"
            ]
        }
    }
}
