terminal-toolbar([tab]='this')
    i.fas.fa-xs.fa-circle.text-success.me-2(*ngIf='session && session.open')
    i.fas.fa-xs.fa-circle.text-danger.me-2(*ngIf='!session || !session.open')
    strong.me-auto {{profile.options.host}}:{{profile.options.port}}

    button.btn.btn-sm.btn-link.me-2((click)='reconnect()', [disabled]='reconnectInProgress')
        i.fas.fa-circle-notch.fa-spin(*ngIf='reconnectInProgress')
        i.fas.fa-redo(*ngIf='!reconnectInProgress')
        span(*ngIf='!reconnectInProgress', translate) Reconnect
        span(*ngIf='reconnectInProgress', translate) Reconnecting...
