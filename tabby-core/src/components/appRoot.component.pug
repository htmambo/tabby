title-bar(
  *ngIf='ready && !hostWindow.isFullscreen && config.store.appearance.dock == "off" && isTitleBarNeeded()',
  (dblclick)='toggleMaximize()',
  [hideControls]='hostApp.platform !== Platform.Linux && !hostWindow.isFullscreen',
  [class.inset]='hostApp.platform == Platform.macOS && !hostWindow.isFullscreen'
)

.content(
    *ngIf='ready',
    [class.tabs-on-top]='config.store.appearance.tabsLocation == "top" || config.store.appearance.tabsLocation == "left" || config.store.appearance.tabsLocation == "right"',
    [class.tabs-on-left]='hasVerticalTabs() && config.store.appearance.tabsLocation == "left"',
    [class.tabs-titlebar-enabled]='isTitleBarNeeded()',
    [class.tabs-on-right]='hasVerticalTabs() && config.store.appearance.tabsLocation == "right"',
    [style.--tab-fixed-width.px]='fixedTabWidth'
)
    .tab-bar(
        *ngIf='!hostWindow.isFullscreen || config.store.appearance.tabsInFullscreen',
        [class.tab-bar-no-controls-overlay]='hostApp.platform == Platform.macOS',
        (dblclick)='!isTitleBarNeeded() && toggleMaximize()'
    )
        .inset.background(*ngIf='hostApp.platform == Platform.macOS \
        && !hostWindow.isFullscreen \
        && config.store.appearance.frame == "thin" \
        && (config.store.appearance.tabsLocation == "top" || config.store.appearance.tabsLocation == "left")')
        .tabs(
            cdkDropList,
            [cdkDropListOrientation]='(config.store.appearance.tabsLocation == "top" || config.store.appearance.tabsLocation == "bottom") ? "horizontal" : "vertical"',
            (cdkDropListDropped)='onTabsReordered($event)',
            cdkAutoDropGroup='app-tabs'
        )
            tab-header(
                *ngFor='let tab of app.tabs; let idx = index',
                [index]='idx',
                [tab]='tab',
                [active]='tab == activeTab',
                [@animateTab]='{value: "in", params: {size: targetTabSize}}',
                [@.disabled]='hasVerticalTabs() || !config.store.accessibility.animations',
                (click)='app.selectTab(tab)',
                [class.fully-draggable]='hostApp.platform !== Platform.macOS',
                [ngbTooltip]='tab.customTitle || tab.title'
            )

        .btn-group.background
            .d-flex(
                *ngFor='let button of leftToolbarButtons'
            )
                button.btn.btn-secondary.btn-tab-bar(
                    [ngbTooltip]='button.label',
                    (click)='button.run && button.run()',
                    [fastHtmlBind]='button.icon'
                )

            .d-flex(
                ngbDropdown,
                container='body',
                #activeTransfersDropdown='ngbDropdown'
            )
                button.btn.btn-secondary.btn-tab-bar(
                    [hidden]='activeTransfers.length == 0',
                    [ngbTooltip]='"File transfers"|translate',
                    ngbDropdownToggle
                ) !{require('../icons/transfers.svg')}
                transfers-menu(
                    ngbDropdownMenu,
                    [(transfers)]='activeTransfers',
                    (transfersChange)='onTransfersChange()'
                )

        .btn-space.background(
            [class.persistent]='config.store.appearance.frame == "thin"',
            [class.drag]='config.store.appearance.frame == "thin" \
            && ((config.store.appearance.tabsLocation !== "left" && config.store.appearance.tabsLocation !== "right") || hostApp.platform !== Platform.macOS)'
        )

        .btn-group.background
            .d-flex(
                *ngFor='let button of rightToolbarButtons'
            )
                button.btn.btn-secondary.btn-tab-bar(
                    [ngbTooltip]='button.label',
                    (click)='button.run && button.run()',
                    [fastHtmlBind]='button.icon'
                )

            button.btn.btn-secondary.btn-tab-bar.btn-update(
                *ngIf='updatesAvailable',
                [ngbTooltip]='"Update available - Click to install"|translate',
                (click)='updater.update()'
            ) !{require('../icons/gift.svg')}

        window-controls.background(
            *ngIf='config.store.appearance.frame == "thin" \
            && config.store.appearance.tabsLocation !== "left" \
            && config.store.appearance.tabsLocation !== "right" \
            && hostApp.platform == Platform.Linux',
        )

        div.window-controls-spacer(
            *ngIf='config.store.appearance.frame == "thin" && (hostApp.platform == Platform.Windows) && (config.store.appearance.tabsLocation == "top")',
        )

    .content.royal-workspace(
        [class.with-royal-sidebar]='shouldShowRoyalSidebar()',
        [class.royal-sidebar-collapsed]='royalSidebarCollapsed',
        [style.--royal-sidebar-expanded-width.px]='royalSidebarWidth'
    )
        aside.royal-sidebar(
            *ngIf='shouldShowRoyalSidebar()',
            [class.tree-mode]='isRoyalSidebarTreeMode',
            [class.collapsed]='royalSidebarCollapsed',
            (transitionend)='onRoyalSidebarTransitionEnd($event)',
            (mouseenter)='royalSidebarCollapsed && onRoyalSidebarContainerMouseEnter()',
            (mouseleave)='royalSidebarCollapsed && onRoyalSidebarContainerMouseLeave()'
        )
            .royal-sidebar-header
                button.btn.btn-link.royal-sidebar-badge(
                    *ngIf='royalSidebarCollapsed',
                    type='button',
                    [ngbTooltip]='royalSidebarTitle',
                    tooltipClass='royal-sidebar-tooltip',
                    container='body',
                    placement='right',
                    (mouseenter)='onRoyalSidebarBadgeMouseEnter()',
                    (mouseleave)='onRoyalSidebarBadgeMouseLeave($event)',
                    (focus)='onRoyalSidebarBadgeMouseEnter()',
                    (blur)='onRoyalSidebarBadgeMouseLeave()',
                    [attr.aria-label]='royalSidebarTitle'
                )
                    i.fas.fa-folder-tree(aria-hidden='true')
                .royal-sidebar-title-wrap(*ngIf='!royalSidebarCollapsed')
                    .royal-sidebar-title-icon(aria-hidden='true')
                        i.fas.fa-folder-tree
                    .royal-sidebar-title {{royalSidebarTitle}}
                .d-flex(ngbDropdown, *ngIf='!royalSidebarCollapsed')
                    button.btn.btn-link.royal-sidebar-menu(
                        type='button',
                        ngbDropdownToggle,
                        [ngbTooltip]='royalSidebarOptionsAriaLabel',
                        tooltipClass='royal-sidebar-tooltip',
                        container='body',
                        placement='bottom',
                        [attr.aria-label]='royalSidebarOptionsAriaLabel'
                    )
                        i.fas.fa-sliders-h(aria-hidden='true')
                    div(ngbDropdownMenu)
                        button(ngbDropdownItem, (click)='setRoyalSidebarViewMode("cards")')
                            i.fas.fa-fw([class.fa-check]='royalSidebarViewMode === "cards"', [class.fa-minus]='royalSidebarViewMode !== "cards"')
                            span(translate) Card view
                        button(ngbDropdownItem, (click)='setRoyalSidebarViewMode("tree")')
                            i.fas.fa-fw([class.fa-check]='royalSidebarViewMode === "tree"', [class.fa-minus]='royalSidebarViewMode !== "tree"')
                            span(translate) Tree view
                        div.dropdown-divider
                        button(ngbDropdownItem, (click)='toggleRoyalSingleExpandMode()')
                            i.fas.fa-fw([class.fa-check]='royalSingleExpandMode', [class.fa-minus]='!royalSingleExpandMode')
                            span(translate) Single expand mode
                button.btn.btn-link.royal-sidebar-toggle(
                    type='button',
                    [ngbTooltip]='royalSidebarToggleAriaLabel',
                    tooltipClass='royal-sidebar-tooltip',
                    container='body',
                    [placement]='royalSidebarCollapsed ? "right" : "bottom"',
                    (click)='toggleRoyalSidebar()',
                    [attr.aria-label]='royalSidebarToggleAriaLabel'
                )
                    i.fas(
                        [class.fa-angles-right]='royalSidebarCollapsed',
                        [class.fa-angles-left]='!royalSidebarCollapsed',
                        aria-hidden='true'
                    )
            .royal-sidebar-content(
                *ngIf='!royalSidebarCollapsed || royalSidebarPreviewVisible',
                [class.floating-preview]='royalSidebarCollapsed',
                (mouseenter)='royalSidebarCollapsed && onRoyalSidebarPreviewMouseEnter()',
                (mouseleave)='royalSidebarCollapsed && onRoyalSidebarPreviewMouseLeave($event)'
            )
                .royal-sidebar-search
                    .royal-sidebar-search-field
                        i.fas.fa-search.royal-sidebar-search-icon(aria-hidden='true')
                        input.form-control.form-control-sm(
                            type='search',
                            [placeholder]='royalSidebarFilterPlaceholder',
                            [ngModel]='sidebarFilter',
                            (ngModelChange)='onSidebarFilterChange($event)'
                        )
                .royal-nav-sections
                    ng-container(*ngIf='filteredRoyalConnectionGroups as connectionGroups')
                        .royal-nav-section(*ngIf='connectionGroups.length > 0')
                            .royal-nav-section-title {{allConnectionsSectionTitle}}
                            .royal-nav-groups
                                .royal-nav-group(*ngFor='let group of connectionGroups; trackBy: connectionGroupTrackBy')
                                    button.royal-nav-group-header(
                                        type='button',
                                        [attr.aria-expanded]='!isRoyalGroupCollapsed(royalConnectionGroupKey(group.id))',
                                        (click)='toggleRoyalGroup(royalConnectionGroupKey(group.id))'
                                    )
                                        i.fas.fa-chevron-right.royal-group-toggle-icon(aria-hidden='true')
                                        i.fas.royal-group-folder-icon(
                                            *ngIf='isRoyalSidebarTreeMode',
                                            [class.fa-folder]='isRoyalGroupCollapsed(royalConnectionGroupKey(group.id))',
                                            [class.fa-folder-open]='!isRoyalGroupCollapsed(royalConnectionGroupKey(group.id))',
                                            aria-hidden='true'
                                        )
                                        span.royal-group-name {{group.label}}
                                        span.royal-group-count {{group.items.length}}
                                    .royal-nav-items(*ngIf='!isRoyalGroupCollapsed(royalConnectionGroupKey(group.id))')
                                        button.royal-nav-item.connection-item(
                                            type='button',
                                            *ngFor='let item of group.items; trackBy: connectionItemTrackBy',
                                            [class.active]='isRoyalConnectionActive(item)',
                                            (click)='activateRoyalConnection(item)',
                                            (contextmenu)='showRoyalConnectionContextMenu(item, $event)'
                                        )
                                            span.royal-nav-item-main
                                                profile-icon.royal-nav-item-icon(
                                                    *ngIf='item.profile.icon',
                                                    [icon]='item.profile.icon',
                                                    [color]='item.profile.color ?? undefined'
                                                )
                                                i.fas.fa-terminal.royal-nav-item-icon.royal-nav-item-fallback-icon(
                                                    *ngIf='isRoyalSidebarTreeMode && !item.profile.icon',
                                                    aria-hidden='true'
                                                )
                                                span.royal-nav-item-title([ngbTooltip]='item.title', tooltipClass='royal-sidebar-tooltip', container='body') {{item.title}}
                                            span.royal-nav-item-meta {{item.kind}}
                    ng-container(*ngIf='royalSessionGroups as sessionGroups')
                        .royal-nav-section(*ngIf='sessionGroups.length > 0')
                            .royal-nav-section-title {{activeSessionsSectionTitle}}
                            .royal-nav-groups
                                .royal-nav-group(*ngFor='let group of sessionGroups; trackBy: navGroupTrackBy')
                                    button.royal-nav-group-header(
                                        type='button',
                                        [attr.aria-expanded]='!isRoyalGroupCollapsed(royalSessionGroupKey(group.id))',
                                        (click)='toggleRoyalGroup(royalSessionGroupKey(group.id))'
                                    )
                                        i.fas.fa-chevron-right.royal-group-toggle-icon(aria-hidden='true')
                                        i.fas.royal-group-folder-icon(
                                            *ngIf='isRoyalSidebarTreeMode',
                                            [class.fa-folder]='isRoyalGroupCollapsed(royalSessionGroupKey(group.id))',
                                            [class.fa-folder-open]='!isRoyalGroupCollapsed(royalSessionGroupKey(group.id))',
                                            aria-hidden='true'
                                        )
                                        span.royal-group-name {{group.label}}
                                        span.royal-group-count {{group.items.length}}
                                    .royal-nav-items(*ngIf='!isRoyalGroupCollapsed(royalSessionGroupKey(group.id))')
                                        button.royal-nav-item(
                                            type='button',
                                            *ngFor='let item of group.items; trackBy: navItemTrackBy',
                                            [class.active]='isRoyalSessionActive(item)',
                                            (click)='activateRoyalSession(item)',
                                            (contextmenu)='showRoyalSessionContextMenu(item, $event)'
                                        )
                                            span.royal-nav-item-main
                                                i.fas.fa-terminal.royal-nav-item-icon.royal-nav-item-fallback-icon(*ngIf='isRoyalSidebarTreeMode', aria-hidden='true')
                                                span.royal-nav-item-title([ngbTooltip]='item.title', tooltipClass='royal-sidebar-tooltip', container='body') {{item.title}}
                                            span.royal-nav-item-meta {{item.kind}}
            button.royal-sidebar-resizer(
                *ngIf='!royalSidebarCollapsed',
                type='button',
                (mousedown)='onRoyalSidebarResizeStart($event)'
            )

        start-page.content-tab.content-tab-active(*ngIf='app.tabs.length == 0')

        tab-body.content-tab(
            #tabBodies,
            *ngFor='let tab of unsortedTabs',
            [class.content-tab-active]='tab == activeTab',
            [active]='tab == activeTab',
            [tab]='tab',
        )

ng-template(ngbModalContainer)
